def validate_inputs(
    in_dir: Path,
    in_file_ext: str,
    sample_file: Path,
    db_dir: Path,
    out_dir: Path,
    cpu: int,
) -> list[str]:
    """Validate samples and reject output directories containing stale evidence."""
    if cpu < 1:
        raise ValueError("--cpu must be a positive integer")
    if not in_file_ext or any(char in in_file_ext for char in "/\\\x00"):
        raise ValueError("--in_file_ext must be a filename extension")
    samples = sample_file.read_text(encoding="utf-8").splitlines()
    samples = [sample.strip() for sample in samples]
    if not samples or len(set(samples)) != len(samples):
        raise ValueError("sample list must contain nonempty, unique identifiers")
    for sample in samples:
        if (
            not sample
            or sample in {".", ".."}
            or any(char in sample for char in "/\\\x00")
        ):
            raise ValueError(f"invalid sample identifier: {sample!r}")
    required = [in_dir / f"{sample}.{in_file_ext}" for sample in samples]
    required.extend([db_dir / "GVHoP_GVOGs.hmm", db_dir / "GVHoP_GVEUKs.dmnd"])
    for path in required:
        if not path.is_file() or path.stat().st_size == 0:
            raise ValueError(f"required input is missing or empty: {path}")
    if out_dir.exists() and (not out_dir.is_dir() or any(out_dir.iterdir())):
        raise ValueError(f"output directory must be absent or empty: {out_dir}")
    return samples


def check_resources() -> None:
    """Check bundled models and feature definitions before launching searches."""
    required = [ROOT / "NNclf/nn_all.pt", ROOT / "NNclf/preprocessor_all.joblib"]
    for family in ("GVOGs", "GVEUKs"):
        required.extend(
            ROOT / f"source_data/features/GVHoP_{family}_{subset}.tsv"
            for subset in ("all", "top")
        )
        for level in ("top", "intermediate", "bottom"):
            required.extend(
                ROOT / f"XGBclf/clf_{family}/{level}/XGB_{i}.joblib"
                for i in range(1, 101)
            )
    for path in required:
        if not path.is_file() or path.stat().st_size == 0:
            raise ValueError(f"required model resource is missing or empty: {path}")


def cmd_hmmer(
    in_dir: Path,
    in_file_ext: str,
    out_dir: Path,
    db_dir: Path,
    cpu: int,
    sample_ls: list[str],
) -> list[list[str]]:
    """Build HMMER commands within the total CPU budget, including its coordinator."""
    target = out_dir / "hmmsearch"
    target.mkdir(parents=True, exist_ok=True)
    return [
        [
            "hmmsearch",
            "--cpu",
            str(cpu - 1),
            "-E",
            "1e-5",
            "--domtblout",
            str(target / f"{sample}.domout"),
            str(db_dir / "GVHoP_GVOGs.hmm"),
            str(in_dir / f"{sample}.{in_file_ext}"),
        ]
        for sample in sample_ls
    ]


def cmd_diamond(
    in_dir: Path,
    in_file_ext: str,
    out_dir: Path,
    db_dir: Path,
    cpu: int,
    sample_ls: list[str],
) -> list[list[str]]:
    """Build DIAMOND commands for the requested samples in their declared order."""
    target = out_dir / "diamond_blastp"
    target.mkdir(parents=True, exist_ok=True)
    return [
        [
            "diamond",
            "blastp",
            "-d",
            str(db_dir / "GVHoP_GVEUKs.dmnd"),
            "-q",
            str(in_dir / f"{sample}.{in_file_ext}"),
            "-o",
            str(target / f"{sample}.txt"),
            "-f",
            "6",
            "-p",
            str(cpu),
            "--evalue",
            "1e-5",
        ]
        for sample in sample_ls
    ]


def execute_cmd(command: list[str], log_file: Path) -> None:
    """Run one search and propagate failure with its per-sample log location."""
    with log_file.open("w", encoding="utf-8") as log:
        try:
            subprocess.run(command, stdout=log, stderr=subprocess.STDOUT, check=True)
        except subprocess.CalledProcessError as error:
            raise RuntimeError(f"{command[0]} failed; see {log_file}") from error


def run_jobs(commands: list[list[str]], log_dir: Path, sample_ls: list[str]) -> None:
    """Run searches sequentially so each process can use the declared CPU budget."""
    log_dir.mkdir(parents=True, exist_ok=True)
    for command, sample in zip(commands, sample_ls, strict=True):
        execute_cmd(command, log_dir / f"{sample}.log")


def hmmparser(hmmer_in: Path) -> dict[str, dict[str, int]]:  # noqa: PLR0915  # Keep the published hit-selection algorithm intact in this inference fix.
    """Count the best qualifying GVOG hit per protein in each sample."""
    hits = []
    content_dict = defaultdict(dict)
    for filenames in (path.name for path in hmmer_in.iterdir()):
        if filenames.endswith(".domout"):
            acc = Path(filenames).stem
            f = (hmmer_in / filenames).open(encoding="utf-8")
            o = (hmmer_in / f"{filenames}.parsed").open("w", encoding="utf-8")
            o.write(
                "protein_id\taccession\tbest_hit\taln_start\taln_end\t"
                "aln_length\tscore\ttype\n"
            )
            hit_dict = {}
            start_dict = {}
            end_dict = {}
            bit_dict: defaultdict[str, float] = defaultdict(float)
            position_dict = defaultdict(list)
            for line in f.readlines():
                if line.startswith("#"):
                    pass
                else:
                    newline = re.sub(r"\s+", "\t", line)
                    list1 = newline.split("\t")
                    ids = list1[0]
                    hit = re.sub("_", "", list1[3])
                    score = float(list1[7])
                    domain_evalue = float(list1[11])
                    if score > bit_dict[ids] and domain_evalue < 1e-3:
                        ids_hit = ids + "." + hit
                        start = int(list1[15])
                        end = int(list1[16])
                        position_dict[ids_hit].append(start)
                        position_dict[ids_hit].append(end)
                        hit_dict[ids] = hit
                        start_dict[ids] = start
                        end_dict[ids] = end
                        bit_dict[ids] = score
            bit_sorted = sorted(
                bit_dict.items(), key=operator.itemgetter(1), reverse=True
            )
            output_list = []
            for item in bit_sorted:
                entry = item[0]
                score = item[1]
                if score > 0:
                    # print entry, item, filenames
                    ids_hit = entry + "." + hit_dict[entry]
                    output_list.append(
                        entry
                        + "\t"
                        + str(hit_dict[entry])
                        + "\t"
                        + str(min(position_dict[ids_hit]))
                        + "\t"
                        + str(max(position_dict[ids_hit]))
                        + "\t"
                        + str(bit_dict[entry])
                    )
            done = []
            for line in output_list:
                line1 = line.rstrip()
                tabs = line1.split("\t")
                ids = tabs[0]
                hits.append(ids)
                cog = tabs[1]
                start = tabs[2]
                end = tabs[3]
                aln_length = str(abs(float(end) - float(start)))
                score = tabs[4]
                nr = acc + "_" + cog
                if nr in done:
                    content_dict[acc][cog] += 1
                    o.write(
                        ids
                        + "\t"
                        + acc
                        + "\t"
                        + cog
                        + "\t"
                        + start
                        + "\t"
                        + end
                        + "\t"
                        + aln_length
                        + "\t"
                        + score
                        + "\tNH\n"
                    )
                else:
                    content_dict[acc][cog] = 1
                    o.write(
                        ids
                        + "\t"
                        + acc
                        + "\t"
                        + cog
                        + "\t"
                        + start
                        + "\t"
                        + end
                        + "\t"
                        + aln_length
                        + "\t"
                        + score
                        + "\tBH\n"
                    )
                    done.append(nr)
            f.close()
            o.close()
    return content_dict


def blastparser(blast_in: Path) -> dict[str, dict[str, float]]:
    """Read headerless DIAMOND output and retain each reference's maximum score."""
    # Read data from input files
    blastfiles = [path for path in blast_in.iterdir() if path.suffix == ".txt"]
    # Check presence/absence of hits
    score_dict = defaultdict(dict)
    for file in blastfiles:
        filename = Path(file).stem
        try:
            result = pd.read_csv(file, sep="\t", header=None, dtype={1: str})
        except pd.errors.EmptyDataError:
            result = pd.DataFrame()
        if not result.empty:
            hits = result.iloc[:, 1].to_list()
            for i in range(len(hits)):
                if filename in score_dict[hits[i]].keys():
                    if result.iloc[i, 11] > score_dict[hits[i]][filename]:
                        score_dict[hits[i]][filename] = result.iloc[i, 11]
                else:
                    score_dict[hits[i]][filename] = result.iloc[i, 11]
    return score_dict

def xgb_gpu_available(cpu: int) -> bool:
    """Probe once with valid labels and reject XGBoost's silent CPU fallback."""
    try:
        model = xgb.XGBClassifier(
            tree_method="hist", device="cuda", n_estimators=1, n_jobs=cpu
        )
        model.fit(np.array([[0], [1], [2], [3]]), np.array([0, 1, 0, 1]))
    except xgb.core.XGBoostError:
        return False
    config = json.loads(model.get_booster().save_config())
    return config["learner"]["generic_param"]["device"].startswith("cuda")


def load_xgb_model(path: Path, cpu: int, device: str) -> Pipeline:
    """Load a trained pipeline with the selected device and CPU budget."""
    model = joblib.load(path)
    model.named_steps["feature_selector"].set_params(
        estimator__device=device, estimator__n_jobs=cpu
    )
    model.named_steps["classifier"].set_params(device=device, n_jobs=cpu)
    return model


def run_XGBclf(data_df, scaler_col, model, prob_out, hosts):
    # Load new data (unlabeled)
    X_test = data_df.to_numpy()
    X_test_final = []
    for i, scaler in enumerate(model.named_steps['scalers']):
        X_block = X_test[:, i*scaler_col:(i+1)*scaler_col]
        X_block_scaled = scaler.transform(X_block)
        X_test_final.append(X_block_scaled)
    X_test_scaled = np.concatenate(X_test_final, axis=1)
    feature_selector = model.named_steps["feature_selector"]
    clf = model.named_steps["classifier"]
    X_test_selected = feature_selector.transform(X_test_scaled)
    y_scores = clf.predict(X_test_selected, output_margin=True)
    prob_out_new = pd.concat([prob_out.reset_index(drop=True), 
                              pd.DataFrame(y_scores, columns = hosts).reset_index(drop=True)], 
                              axis=1)
    return prob_out_new

def aggregate_prob(probs, node_dict, node_name):
    return sum(probs[i] for i in node_dict[node_name])

def climbing_inference(prob_tb, hierarch_list, node_dict, threshold):
    """
    Function for climbing inference for HSC
    # ex: test_label: 2130 (from most specific → most general)
    # pred_label: --30 (from most specific → most general)
    # from predicted leaf to root
    """
    # ----------------------------
    # Reverse the hierarch from most specific → most general
    # ----------------------------
    rev_hierarch_list = [sublist[::-1] for sublist in hierarch_list]

    # ----------------------------
    # Define correct answers
    # ----------------------------
    prob_out_levels = {}
    prob_out_levels["testset"] = prob_tb["testset"].to_list()
    # prob_out_levels["test_label"] = [[x] for x in prob_tb["test_label"].to_list()]
    y_pred = prob_tb["pred_label"].to_numpy()
    y_predpr = prob_tb.iloc[:, 2:].to_numpy()

    hierarch_dict = {}
    for i in range(len(hierarch_list[0])):
        labels = sorted({sublist[i] for sublist in rev_hierarch_list})
        hierarch_dict[f"level{i}"] = labels
    # ----------------------------
    # Climbing inference rule with threshold
    # ----------------------------
    prob_out_levels["pred_label"] = []
    prob_out_levels["pred_hierarchy"] = []
    for i in range(len(hierarch_list[0])):
        prob_out_levels[f"level{i}_prob"] = []

    for j in range(len(y_pred)):
        pred_l = y_pred[j] # predicted label: 0, 1, 2...
        predpr = y_predpr[j] # probabilities of predictions
        prediction = hierarch_dict["level0"][pred_l] # predicted name
        hierach_of_pred_l = [item for sublist in rev_hierarch_list if prediction in sublist for item in sublist] # hierarch of predicted label
        pred_label_index = []
        pred_label_hierarch = []
        # climbing
        for h in range(len(hierach_of_pred_l)):
            p = aggregate_prob(predpr, node_dict, hierach_of_pred_l[h])
            if p >= threshold:
                prob_out_levels[f"level{h}_prob"].append(p)
                pr = hierarch_dict[f"level{h}"].index(hierach_of_pred_l[h])
                pred_label_index.append(str(pr))
                pred_label_hierarch.append(hierach_of_pred_l[h])
            else:
                prob_out_levels[f"level{h}_prob"].append("-")
                pred_label_index.append("-")
                pred_label_hierarch.append("-")
        prob_out_levels["pred_label"].append(",".join(pred_label_index))
        prob_out_levels["pred_hierarchy"].append(",".join(pred_label_hierarch))
    df = pd.DataFrame(prob_out_levels)
    df = df[
        ["testset", "pred_label", "pred_hierarchy"]
        + [f"level{i}_prob" for i in range(len(hierarch_list[0]))]
    ]
    return df

def count_predictions_BU(prob_tb, all_pred, samples_pred):
    """Count hierarchy outputs"""
    pred_roots = 0
    test_ids = prob_tb["testset"].to_list()
    pred_label = [h.split(",") for h in prob_tb["pred_label"].to_list()]
    pred_hierarch = [h.split(",") for h in prob_tb["pred_hierarchy"].to_list()]
    for i in range(len(pred_label)):
        id = test_ids[i]
        for j in range(len(pred_label[0])):
            if pred_hierarch[i][j] != "-":			
                for k in range(j, len(pred_label[0])):
                    samples_pred[id][k][pred_hierarch[i][k]] += 1
                all_pred[id][pred_hierarch[i][k]] += 1
                break
            elif j == len(pred_label[0]) - 1:
                all_pred[id]["root"] += 1
                pred_roots += 1

def flatten_nested(lst):
    flattened_lst = []
    for item in lst:
        if isinstance(item, list):
            for subitem in flatten_nested(item):
                if subitem not in flattened_lst:
                    flattened_lst.append(subitem)
        else:
            if item not in flattened_lst:
                flattened_lst.append(item)
    return flattened_lst


def prepare_features(
    hmm_dict: dict[str, dict[str, int]],
    blast_dict: dict[str, dict[str, float]],
    sample_ls: list[str],
    feature_dir: Path,
) -> tuple[pd.DataFrame, pd.DataFrame]:
    """Keep sample rows and trained feature order, including zero-hit samples."""
    frames = []
    for raw_frame, family in (
        (pd.DataFrame(hmm_dict).T, "GVOGs"),
        (pd.DataFrame(blast_dict), "GVEUKs"),
    ):
        frame = raw_frame.fillna(0).astype(int)
        frame.columns = frame.columns.astype(str)
        frame.index.name = "testset"
        feature_path = feature_dir / f"GVHoP_{family}_all.tsv"
        columns = feature_path.read_text(encoding="utf-8").strip().split("\t")
        frame = frame.reindex(columns=columns, fill_value=0)
        frames.append(frame.reindex(sample_ls, fill_value=0))
    return frames[0], frames[1]


def write_prediction_counts(
    prob_tb: pd.DataFrame,
    sample_ls: list[str],
    hierarch_list: list[list[str]],
    out_dir: Path,
) -> None:
    """Export accepted replicate counts at each level using the input sample IDs."""
    all_pred = defaultdict(dict)
    for sample in sample_ls:
        all_pred[sample] = dict.fromkeys(flatten_nested(hierarch_list), 0)
        all_pred[sample]["root"] = 0
    samples_pred = defaultdict(lambda: defaultdict(dict))
    reversed_hierarchy = [branch[::-1] for branch in sorted(hierarch_list)]
    for level in range(len(hierarch_list[0])):
        labels = [branch[level] for branch in reversed_hierarchy]
        for sample in sample_ls:
            samples_pred[sample][level] = dict.fromkeys(labels, 0)
    count_predictions_BU(prob_tb, all_pred, samples_pred)
    out_dir.mkdir(parents=True, exist_ok=True)
    for level in range(len(hierarch_list[0])):
        frame = pd.DataFrame(
            {sample: samples_pred[sample][level] for sample in sample_ls}
        ).T
        frame = frame.reindex(sample_ls, fill_value=0)
        frame.index.name = "testset"
        frame.to_csv(
            out_dir / f"pred_out_level{level}.tsv", sep="\t", index=True, header=True
        )


def main() -> None:  # noqa: PLR0915  # Preserve the existing model sequence while fixing its inputs and execution.
    """Validate inputs, run searches, and export the trained ensemble predictions."""
    parser = argparse.ArgumentParser(
            description=("Giant Virus-Host Predictor"),
            formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    parser.add_argument(
        "--in_dir",
        type=Path,
        default=ROOT / "example_MAGs",
        help="The directory of input files.",
    )
    parser.add_argument("--in_file_ext",
                        required=True,
                        default="faa",
                        type=str)
    parser.add_argument(
        "--sample_ls",
        type=Path,
        required=True,
        default="./source_data/example_inputs/sample.ls",
        help="The list of samples to be predicted.",
    )
    parser.add_argument(
        "--db_dir",
        default="GVHoP_database_v1.0/",
        required=True,
        type=Path,
        help="Directory containing database files.",
    )
    parser.add_argument(
        "--out_dir",
        type=Path,
        required=True,
        default="./outdir/",
        help="The directory for output files.",
    )
    parser.add_argument(
        "--cpu",
        type=int,
        required=True,
        default=8,
        help="Total CPU budget; searches run sequentially.",
    )

    # Defining variables from input
    args = parser.parse_args()
    in_dir = args.in_dir
    in_file_ext = args.in_file_ext
    sample_ls = validate_inputs(
        args.in_dir,
        args.in_file_ext,
        args.sample_ls,
        args.db_dir,
        args.out_dir,
        args.cpu,
    )
    db_dir = args.db_dir
    out_dir = args.out_dir
    cpu = args.cpu
    check_resources()
    # Apply the CLI budget to native pools for the lifetime of this process.
    threadpool_limits(limits=cpu)
    torch.set_num_threads(cpu)
    xgb_device = "cuda" if xgb_gpu_available(cpu) else "cpu"

    """ Prepare host lists """    
    top_ls = ['Algae', 'Amoeba', 'Fungi', 'Heteroflagellate', 'Metazoa']
    intermediate_ls = ['Amoeboid', 'Amoebozoa', 'Blastocladiomycota', 'Brownalgae', 'Chlorophyta', 'Chytridiomycota', 'Haptophyta', 'Invertebrate', 'Nonamoeboid', 'Otheralgae', 'Vertebrate']
    bottom_ls = ['Aves', 'Bathycoccaceae', 'Blastocladiomycetes', 'Chlorellaceae', 'Choanocafe', 'Chytridiomycetes', 'Coccolithophyceae', 'Discoba', 'Discosea', 'Insecta', 'Malacostraca', 'Mamiellaceae', 'Mammalia', 'Otherchlorophyta', 'Otherhaptophyta', 'Otherinvertebrate', 'Othervertebrate', 'Phaeophyceae', 'Prymnesiaceae', 'Stramenopile', 'Tubulinea']

    """ Create output directory """
    os.makedirs(out_dir, exist_ok=True)

    """ Run Diamond and HMMER """
    print("Running Diamond and HMMER...")
    hmmer_cmd = cmd_hmmer(in_dir, in_file_ext, out_dir, db_dir, cpu, sample_ls)
    diamond_cmd = cmd_diamond(in_dir, in_file_ext, out_dir, db_dir, cpu, sample_ls)
    run_jobs(diamond_cmd, out_dir / "execute/diamond_blastp", sample_ls)
    run_jobs(hmmer_cmd, out_dir / "execute/hmmer", sample_ls)
    print("Finished running Diamond and HMMER!")

    """ Parse results """
    print("Parsing results...")
    hmm_dict = hmmparser(out_dir / "hmmsearch")
    blast_dict = blastparser(out_dir / "diamond_blastp")

    # Combine all rows into a DataFrame
    hmm_df, blast_df = prepare_features(
        hmm_dict, blast_dict, sample_ls, ROOT / "source_data/features"
    )

    # Create the dictionary for saving the raw scores
    prob_out_dict = defaultdict(list)

    """ clf_GVOGs """
    # Select the samples
    hmm_df = hmm_df.reindex(sample_ls, fill_value=0)
    # Save the dataframe for future use
    os.makedirs(f"{out_dir}/FeatureSets/", exist_ok=True)
    hmm_df.to_csv(f"{out_dir}/FeatureSets/GVOGs_all.tsv", sep='\t', index=True, header=True)
    # Select GVHoP top features
    top_feature_cols = (
        (ROOT / "source_data/features/GVHoP_GVOGs_top.tsv")
        .read_text(encoding="utf-8")
        .strip()
        .split("\t")
    )
    top_GVOGs_df = hmm_df.reindex(columns=top_feature_cols, fill_value=0)
    # Save the dataframe for future use
    top_GVOGs_df.to_csv(f"{out_dir}/FeatureSets/GVOGs_top.tsv", sep='\t', index=True, header=True)
    # Create a dataframe for saving probability
    prob_out = pd.DataFrame({'testset': sample_ls})
    # Load model
    print("Initialize clf_GVOGs...")
    # Suppress warnings before loading the model, back to normal with "default" setting.
    warnings.filterwarnings('ignore', category=UserWarning)
    for i in range(1, 101):
        ## clf_top ##
        print(f"clf_GVOGs_top_{i}_model")
        model = load_xgb_model(
            ROOT / f"XGBclf/clf_GVOGs/top/XGB_{i}.joblib", cpu, xgb_device
        )
        host_ls = [f"gc_s_{host}" for host in top_ls]
        prob_out_top = run_XGBclf(hmm_df, 8293, model, prob_out, host_ls)
        ## clf_intermediate ##
        print(f"clf_GVOGs_intermediate_{i}_model")
        model = load_xgb_model(
            ROOT / f"XGBclf/clf_GVOGs/intermediate/XGB_{i}.joblib", cpu, xgb_device
        )
        host_ls = [f"gc_s_{host}" for host in intermediate_ls]
        prob_out_intermediate = run_XGBclf(hmm_df, 8293, model, prob_out, host_ls)
        ## clf_bottom ##
        print(f"clf_GVOGs_bottom_{i}_model")
        model = load_xgb_model(
            ROOT / f"XGBclf/clf_GVOGs/bottom/XGB_{i}.joblib", cpu, xgb_device
        )
        host_ls = [f"gc_s_{host}" for host in bottom_ls]
        prob_out_bottom = run_XGBclf(hmm_df, 8293, model, prob_out, host_ls)
        #
